{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Next.js Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal",
      "env": {
        "NODE_OPTIONS": "--inspect"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Next.js Client (Chrome)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "",
      "postDebugTask": ""
    }
  ],
  "compounds": [
    {
      "name": "Debug Next.js (Full Stack)",
      "configurations": ["Next.js Server", "Next.js Client (Chrome)"],
      "stopAll": true
    }
  ]
}
